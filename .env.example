# Copy to .env for local development:  cp .env.example .env
# .env is gitignored — never commit real values. All vars are prefixed SENTINEL_.

SENTINEL_ENVIRONMENT=local
SENTINEL_SERVICE_NAME=sentinelai-api
SENTINEL_LOG_LEVEL=INFO
SENTINEL_LOG_JSON=false
SENTINEL_DATABASE_URL=postgresql+asyncpg://sentinelai:sentinelai@localhost:5432/sentinelai
SENTINEL_REDIS_URL=redis://localhost:6379/0
SENTINEL_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SENTINEL_OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces
